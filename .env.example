# Environment configuration for Virtual Learning Lab

# Database Connection:
# Default for zero-config local development: SQLite
DATABASE_URL="file:./prisma/dev.db"

# For PostgreSQL (Production / Supabase / Neon / Local Docker Postgres):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/virtual_lab?schema=public"

# Authentication & Security
JWT_SECRET="change-this-to-a-very-secure-random-secret-key-in-production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application Environment
NODE_ENV="development"
